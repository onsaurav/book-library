    "metrics": "node scripts/metrics.js",
    "install-into": "node install.js"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "glob": "^13.0.6",
    "js-yaml": "^4.3.1"
  },
