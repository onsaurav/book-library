{
  "name": "itm-sdlc",
  "version": "1.0.0",
  "description": "Agentic SDLC toolkit: requirement spine, project brain, context-isolated reviewer, checkpoint loop and verification gates.",
  "license": "UNLICENSED",
  "private": true,
  "author": "IT Magnet",
  "main": "index.js",
  "bin": {
    "itm-sdlc-install": "install.js"
  },
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "test": "node --test tests/",
    "validate": "node scripts/validate-requirements.js",
    "traceability": "node scripts/check-traceability.js",
