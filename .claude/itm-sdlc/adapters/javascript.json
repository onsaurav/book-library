{
  "$schema": "../schema/adapter.schema.json",
  "id": "javascript",
  "displayName": "JavaScript",
  "detect": [
    "**/package.json"
  ],
  "detectUnless": [
    "**/tsconfig.json",
    "**/tsconfig.*.json"
  ],
  "sourceGlobs": [
    "**/*.js",
    "**/*.mjs",
    "**/*.cjs",
    "**/*.jsx"
  ],
  "testGlobs": [
    "**/*.test.js",
    "**/*.test.mjs",
    "**/*.test.cjs",
    "**/*.test.jsx",
    "**/*.spec.js",
    "**/*.spec.mjs",
    "**/*.spec.jsx",
    "**/tests/**/*.js",
    "**/tests/**/*.mjs",
    "**/test/**/*.js",
    "**/e2e/**/*.js"
  ],
  "ignore": [
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/.next/**",
    "**/coverage/**",
    "**/playwright-report/**"
  ],
  "annotation": {
    "pattern": "(?://\\s*@covers\\s+|type\\s*:\\s*['\"]covers['\"]\\s*,\\s*description\\s*:\\s*['\"])(REQ-[A-Z]{3,8}-\\d{3})(?:@v(\\d+))?",
    "example": "// @covers REQ-SAMPLE-001@v1"
  },
  "commands": {
    "build": "npm run build --if-present",
    "test": "npm test",
    "lint": "npm run lint",
    "coverage": "npm run coverage",
    "format": "npx --yes prettier --write {file}",
    "integration": "npm run test:integration",
    "testFiles": "node --test",
    "integrationFiles": "node --test"
  },
  "ci": {
    "container": "node:20-bookworm"
  },
  "rules": "rules/javascript"
}
